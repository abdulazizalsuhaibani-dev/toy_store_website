# Copy this file to .env and fill in real values. .env is gitignored.
#
# Only DJANGO_SECRET_KEY and DJANGO_DEBUG are needed for local development;
# everything below the first section is set on Render, not here. See
# DEPLOYMENT.md for where each production value comes from.

# ---------------------------------------------------------------- local dev --

# Generate a key with:
#   python -c "import secrets,string; print(''.join(secrets.choice(string.ascii_letters+string.digits) for _ in range(50)))"
DJANGO_SECRET_KEY=

# Defaults to False when unset, which is what a deployed host must get.
# Set it True locally for the debug toolbar-style error pages and to skip the
# HTTPS redirect that would otherwise send localhost to https://localhost.
DJANGO_DEBUG=True

# ------------------------------------------------------------ Render only --

# Comma-separated. Render also injects RENDER_EXTERNAL_HOSTNAME automatically,
# so this only needs the custom domains you add later.
# DJANGO_ALLOWED_HOSTS=toystore.example.com,www.toystore.example.com

# Supabase Postgres, SESSION POOLER string (Connect -> Session pooler in the
# Supabase dashboard). Port 5432 on aws-<region>.pooler.supabase.com.
# NOT db.<ref>.supabase.co (IPv6-only, unreachable from Render) and NOT port
# 6543 (transaction pooler, for serverless). Unset locally -> SQLite.
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Supabase Storage, S3-compatible API (Storage -> S3 Connection in the
# dashboard). Setting SUPABASE_S3_ENDPOINT is what switches uploads from the
# local filesystem to the bucket; the other four are then required.
# SUPABASE_S3_ENDPOINT=https://<project-ref>.storage.supabase.co/storage/v1/s3
# SUPABASE_S3_REGION=<region, e.g. eu-central-1>
# SUPABASE_S3_BUCKET=product-images
# SUPABASE_S3_ACCESS_KEY_ID=
# SUPABASE_S3_SECRET_ACCESS_KEY=

# Optional. When all three are set, the Render build creates this superuser if
# no account with that username exists yet. Free instances have no shell, so
# this is the only way to get an admin login on the first deploy. Remove them
# from the Render dashboard once the account exists.
# DJANGO_SUPERUSER_USERNAME=
# DJANGO_SUPERUSER_EMAIL=
# DJANGO_SUPERUSER_PASSWORD=
